# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/university_login?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Motor LBEn (endpoint FastAPI en Vercel; ignorado en desarrollo local)
LBEN_SECRET=""

# 2FA TOTP: clave AES-256-GCM para cifrar el secreto TOTP en la BD (base64 de 32 bytes).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
