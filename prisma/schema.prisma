// Prisma Schema for PostgreSQL Authentication
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id                    String                    @id @default(cuid())
  email                 String                    @unique
  passwordHash          String?
  name                  String?
  role                  Role                      @default(COMUNIDAD_UNIVERSITARIA)
  status                UserStatus                @default(ACTIVE)
  phone                 String?
  lastLoginAt           DateTime?
  twoFactorEnabled      Boolean                   @default(false)
  // Admin-forced 2FA requirement (on/off switch in the admin SecurityTab).
  // Independent of the role policy: an optional-2FA user with this flag is
  // redirected to /twofa/setup exactly like a mandatory role.
  twoFactorRequired     Boolean                   @default(false)
  // TOTP secret encrypted with AES-256-GCM (TOTP_ENCRYPTION_KEY env).
  // Null when the user has never started enrollment. Only trusted for
  // login once totpConfirmedAt is set — setup alone never enables 2FA.
  totpSecretEnc         String?
  totpPendingAt         DateTime?
  totpConfirmedAt       DateTime?
  // Replay protection: highest TOTP time step accepted for this user.
  // Codes at or below this step are rejected even if cryptographically valid.
  totpLastUsedStep      Int?
  // Rate limiting for TOTP verification (replica-safe, lives in the DB).
  twoFactorFailedAttempts Int                   @default(0)
  twoFactorLockedUntil    DateTime?
  // Account settings (self-service, /dashboard/configuracion)
  avatarUrl               String?                 // data-URL (WebP ~256px) — base64, no external storage
  timezone                String                  @default("America/Bogota")
  notificationsEmail      Boolean                 @default(true)
  notificationsInApp      Boolean                 @default(true)
  emailVerified         DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  sessions              Session[]
  permissionOverrides   UserPermissionOverride[]
  twoFactorBackupCodes  TwoFactorBackupCode[]

  @@map("users")
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 hash of the normalized code; the plaintext is shown to the
  // user exactly once at enrollment and never stored.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model UserPermissionOverride {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId        String
  action          String
  expiresAt       DateTime?
  grantedBy       String
  grantedByEmail  String
  createdAt       DateTime @default(now())
  @@unique([userId, moduleId, action])
  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  // Raw User-Agent captured at login — shown in the user's own session list
  // ("Sesiones activas") so people can spot devices they don't recognise.
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String
  action      String
  targetId    String
  targetEmail String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  ADMIN_TI // Administrador (TI)
  GESTOR_ENERGETICO // Gestor Energético
  COORD_INFRAESTRUCTURA // Coord. Infraestructura
  DIRECTIVO // Directivo
  COMUNIDAD_UNIVERSITARIA // Comunidad Universitaria
}

// ============================================================
// SIGE-TdeA — Modelos del módulo de carga energética
// Resolución UPME 0016/2024
// ============================================================

model Edificacion {
  id        String   @id @default(cuid())
  nombre    String
  // Código del catálogo CATALOGO_EDIFICACIONES (ej. EDUCATIVO_CAMPUS)
  tipo      String
  // Área total de la edificación en m² — variable relevante de la línea base
  // (Resolución UPME 0016/2024, §7.3). Nullable: las edificaciones preexistentes
  // conservan NULL hasta que el usuario la complete (compatibilidad sin migración).
  area      Float?
  // Coordenadas de la edificación: necesarias para la fuente climática
  // (Open-Meteo) que alimenta el cálculo de la GDE.
  lat       Float?
  lon       Float?
  createdAt DateTime @default(now())

  bloques    Bloque[]
  facturas   FacturaEnergia[]
  lineasBase LineaBaseEnergia[]
  calendario CalendarioOperativo?
  horarios   HorarioEquipo[]

  @@map("edificaciones")
}

// Horario de funcionamiento de un grupo de equipos de la edificación
// (Resolución UPME 0016/2024, §7.1/§7.3: horarios de operación). Días de la
// semana (códigos LUN..DOM en array de Postgres) + franja horaria diaria.
// Sin cruce de medianoche: una franja que pasa de 23:00 a 06:00 se registra
// como dos filas. Validación de dominio en features/datos/models/horarios.ts.
model HorarioEquipo {
  id            String   @id @default(cuid())
  edificacionId String
  // Ámbito jerárquico (aditivo — S12): todos nulos = horario de la edificación
  // completa (las filas preexistentes); si no, el nivel activo es el más
  // específico de la cascada equipo → espacio → bloque → edificación.
  bloqueId   String?
  espacioId  String?
  equipoId   String?
  nombre     String
  diasSemana String[]
  horaInicio Int
  horaFin    Int
  // Vigencia (aditiva): nula en filas preexistentes; `hasta` nula = abierta.
  desde  DateTime? @db.Date
  hasta  DateTime? @db.Date
  createdAt DateTime @default(now())

  edificacion Edificacion     @relation(fields: [edificacionId], references: [id], onDelete: Cascade)
  bloque      Bloque?         @relation(fields: [bloqueId], references: [id], onDelete: Cascade)
  espacio     Espacio?        @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  equipo      EquipoElectrico? @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@index([edificacionId])
  @@index([bloqueId])
  @@index([espacioId])
  @@index([equipoId])
  @@map("horarios_equipo")
}

// Calendario operativo configurable por edificación (UPME 0016/2024 §7.1/§7.3:
// horarios de operación). La configuración fija el horario operativo diario (H)
// y la temperatura base de climatización (Tb, típicamente 3 °C bajo el confort:
// 20/23/25 °C); los RangoCalendario describen qué días son operativos.
model CalendarioOperativo {
  id                  String   @id @default(cuid())
  edificacionId       String   @unique
  // Hora de inicio del día operativo (0-23) y duración en horas (1-24): define
  // las horas H sobre las que se promedia la temperatura en la fórmula GDE.
  horaInicioOperacion Int
  horasOperacionDia   Int
  // Temperatura base Tb en °C.
  temperaturaBase     Float
  createdAt           DateTime @default(now())

  edificacion Edificacion     @relation(fields: [edificacionId], references: [id], onDelete: Cascade)
  rangos      RangoCalendario[]

  @@map("calendarios_operativos")
}

// Rango de fechas con tipo de día (catálogo CATALOGO_TIPOS_DIA): LECTIVO/HABIL
// son operativos; VACACIONES/FESTIVOS no. Plantillas (p. ej. la del TdeA tomada
// de docs/calendario-*.pdf) son solo datos iniciales editables — sin fechas
// fijas en la lógica.
model RangoCalendario {
  id           String   @id @default(cuid())
  calendarioId String
  fechaInicio  DateTime @db.Date
  fechaFin     DateTime @db.Date
  tipoDia      String
  nombre       String?
  createdAt    DateTime @default(now())

  calendario CalendarioOperativo @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  @@index([calendarioId])
  @@map("rangos_calendario")
}

model Bloque {
  id                   String   @id @default(cuid())
  codigo               String   @unique
  nombre               String
  areaUtil             Float
  factorInfraestructura Float
  edificacionId        String
  createdAt            DateTime @default(now())

  edificacion Edificacion @relation(fields: [edificacionId], references: [id], onDelete: Cascade)

  equipos    EquipoElectrico[]
  espacios   Espacio[]
  variables  VariableOperativa[]
  lineasBase LineaBaseEnergia[]
  ajustes    AjusteEnergetico[]
  horarios   HorarioEquipo[]

  @@index([edificacionId])
  @@map("bloques")
}

model Espacio {
  id        String   @id @default(cuid())
  bloqueId  String
  nombre    String
  createdAt DateTime @default(now())

  bloque  Bloque   @relation(fields: [bloqueId], references: [id], onDelete: Cascade)
  equipos EquipoElectrico[]
  horarios HorarioEquipo[]

  @@unique([bloqueId, nombre])
  @@map("espacios")
}

model EquipoElectrico {
  id             String   @id @default(cuid())
  bloqueId       String
  espacioId      String
  tipo           String
  cantidad       Int
  potenciaNominal Float
  horasUsoDia    Int
  diasUsoMes     Int
  usenIndicador  String
  createdAt      DateTime @default(now())

  bloque  Bloque  @relation(fields: [bloqueId], references: [id], onDelete: Cascade)
  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  horarios HorarioEquipo[]

  @@unique([bloqueId, espacioId, tipo])
  @@index([bloqueId])
  @@index([espacioId])
  @@map("equipos_electricos")
}

model FacturaEnergia {
  id                String   @id @default(cuid())
  // Obligatoria tras el backfill (scripts/backfill-facturas-edificacion.mjs).
  edificacionId     String
  periodo           String
  diasFacturados    Int
  consumoKwh        Float
  consumoNormalizado Float
  costoCop          Float
  creadoAt          DateTime @default(now())
  actualizadoAt     DateTime @default(now()) @updatedAt

  // Restrict (no Cascade): la BD nunca borra facturas en silencio al
  // eliminar una edificación; el bloqueo amigable lo hace la app.
  edificacion Edificacion @relation(fields: [edificacionId], references: [id], onDelete: Restrict)

  @@unique([periodo, edificacionId])
  @@index([edificacionId])
  @@map("facturas_energia")
}

model VariableOperativa {
  id                        String   @id @default(cuid())
  bloqueId                  String
  mes                       Int
  ano                       Int
  poblacionFija             Int
  poblacionFlotante         Int
  diasLectivosLaborales     Int
  gradesDiaEnfriamiento     Float
  createdAt                 DateTime @default(now())

  bloque Bloque @relation(fields: [bloqueId], references: [id], onDelete: Cascade)

  @@unique([bloqueId, mes, ano])
  @@index([bloqueId])
  @@map("variables_operativas")
}

model LineaBaseEnergia {
  id              String   @id @default(cuid())
  bloqueId        String?
  edificacionId   String?
  tipo            String
  coeficientes    Json
  r2              Float?
  pValue          Float?
  rangosConfianza Float
  createdAt       DateTime @default(now())

  bloque      Bloque?      @relation(fields: [bloqueId], references: [id], onDelete: Cascade)
  edificacion Edificacion? @relation(fields: [edificacionId], references: [id], onDelete: Cascade)

  // Alcance exactamente uno por fila (XOR validado en aplicación: Prisma no
  // expone CHECK): una línea base por bloque y tipo, o una por edificación
  // completa y tipo. En Postgres los NULL no colisionan en únicos, así que
  // conviven ambas llaves sin migrar datos existentes.
  @@unique([bloqueId, tipo])
  @@unique([edificacionId, tipo])
  @@map("lineas_base_energia")
}

model AjusteEnergetico {
  id           String   @id @default(cuid())
  bloqueId     String
  tipo         String
  modelo       String?  // VALOR_ABSOLUTO | COCIENTE | ESTADISTICO (para referencias Anexo 4)
  descripcion  String
  periodoInicio DateTime
  periodoFin   DateTime
  valorAjuste  Float
  direccion    String?  // 'incremento' | 'reduccion' (default 'reduccion' para Anexo 4)
  observaciones String?
  createdAt    DateTime @default(now())

  bloque Bloque @relation(fields: [bloqueId], references: [id], onDelete: Cascade)

  @@index([bloqueId])
  @@map("ajustes_energeticos")
}